# Copie para `.env` na mesma pasta e preencha. O `.env` NÃO vai para o git.

# O endereço público desta instância, pelo proxy reverso da VPS.
# Precisa ser HTTPS: o Supabase chama esta API mandando a chave no cabeçalho.
SERVER_URL=https://evo-nos.SEUDOMINIO.com.br

# A chave desta instância. Gere uma longa e aleatória, diferente da do CRM:
#   openssl rand -hex 32
EVOLUTION_API_KEY=

# Senha do Postgres desta instância. Também aleatória:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Para onde a Evolution empurra os eventos. É a Edge Function do Supabase.
# O `secret` é conferido pela função — sem ele, ela recusa a entrega.
WEBHOOK_URL=https://ddfteoeehsticjhojpka.supabase.co/functions/v1/wa-webhook?secret=

# Porta local, só no 127.0.0.1. Mude se a 8081 já estiver ocupada na VPS.
PORTA_LOCAL=8081
